et confirmé.\",\n              \"address\": \"虚构地址一号\",\n              \"time\": \"14:00\",\n              \"period\": null,\n              \"checkIn\": null,\n              \"checkOut\": null,\n              \"from\": null,\n              \"to\": null,\n              \"mode\": null,\n              \"departure\": null,\n              \"arrival\": null,\n              \"reservation\": {\n                \"status\": \"unknown\",\n                \"reference\": null\n              }\n            },\n            {\n              \"type\": \"transfer\",\n              \"title\": \"Train fictif vers 苏州\",\n              \"category\": \"transport\",\n              \"description\": null,\n              \"address\": null,\n              \"time\": null,\n              \"period\": null,\n              \"checkIn\": null,\n              \"checkOut\": null,\n              \"from\": \"上海\",\n              \"to\": \"苏州\",\n              \"mode\": \"train\",\n              \"departure\": \"2027-05-04T09:00\",\n              \"arrival\": \"2027-05-04T10:00\",\n              \"reservation\": {\n                \"status\": \"unknown\",\n                \"reference\": null\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"name\": \"苏州\",\n      \"days\": [\n        {\n          \"title\": \"Jour 2 — jardin\",\n          \"date\": null,\n          \"items\": [\n            {\n              \"type\": \"suggestion\",\n              \"title\": \"Jardin fictif\",\n              \"category\": \"visit\",\n              \"description\": null,\n              \"address\": null,\n              \"time\": null,\n              \"period\": \"Matin\",\n              \"checkIn\": null,\n              \"checkOut\": null,\n              \"from\": null,\n              \"to\": null,\n              \"mode\": null,\n              \"departure\": null,\n              \"arrival\": null,\n              \"reservation\": {\n                \"status\": \"unknown\",\n           