@@ -0,0 +1,20 @@
+import { paletteIds, paletteTokens, PALETTES_KEY } from '../src/palettes.ts';
+
+export function paletteStylesheet() {
+  const rules = paletteIds.flatMap(id => ['light', 'dark'].map(theme => {
+    const tokens = paletteTokens(id, theme);
+    return `html:root:root[data-theme=${theme}][data-palette=${id}] {\n${Object.entries(tokens).map(([key, value]) => `  ${key}: ${value};`).join('\n')}\n  background: var(--surface-alt); color: var(--text);\n}`;
+  }));
+  return `/* Generated by scripts/generate-palettes.mjs from src/palettes.ts. */\n@media screen {\n${rules.join('\n')}\n}\n@media screen and (prefers-reduced-transparency: reduce), screen and (prefers-contrast: more) {\nhtml:root:root[data-theme][data-palette] { --glass: var(--surface); --glass-heavy: var(--field); --glass-chip: var(--surface); --liquid: var(--surface); --liquid-opaque: var(--surface); --liquid-highlight: transparent; --header-liquid: var(--surface-alt); --header-opaque: var(--surface-alt); }\n}\n@media screen and (prefers-contrast: more) { html:root:root[data-theme][data-palette] { --line: var(--control-line); } }\n`;
+}
+export function paletteBootstrap() {
+  const backgrounds = Object.fromEntries(paletteIds.map(id => [id, { light: paletteTokens(id, 'light')['--surface-alt'], dark: paletteTokens(id, 'dark')['--surface-alt'] }]));
+  return `/* Generated; runs before React and before first paint. */\n(function(){
+var root=document.documentElement,theme='system',language='fr',choice={version:1,light:'signature',dark:'signature'},backgrounds=${JSON.stringify(backgrounds)};
+try{var p=JSON.parse(localStorage.getItem('a-l-est-preferences-v1')||'null');if(p){if(p.theme==='light'||p.theme==='dark')theme=p.theme;if(['fr','en','zh-CN','es'].includes(p.language))language=p.language;}}catch(e){}
+try{var c=JSON.parse(localStorage.getItem(${JSON.stringify(PALETTES_KEY)})||'null');if(c&&c.version===1){['light','dark'].forEach(function(k){if(typeof c[k]==='string'&&Object.prototype.hasOwnProperty.call(backgrounds,c[k]))choice[k]=c[k];});}}catch(e){}
+var resolved=theme==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):theme;
+root.dataset.theme=resolved;root.dataset.palette=choice[resolved];root.lang=language;root.style.colorScheme=resolved;
+var meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.setAttribute('content',backgrounds[choice[resolved]][resolved]);
+})();\n`;
+}
