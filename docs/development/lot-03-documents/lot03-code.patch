+// Static instructions only: no notebook, account or source is interpolated here.
+const prompts = {
+  fr: `Mets mon programme au format Markdown ci-dessous pour Détours. Utilise seulement les informations que je fournis. Remplace les champs entre crochets si connus, sinon omets-les. Garde les inconnues et ambiguïtés en Notes. Date seulement si connue explicitement, au format AAAA-MM-JJ ; ne déduis pas l’année. Une activité par ligne ; heure 24 h ou période seulement si fournie. Adresse facultative sur une ligne distincte. Sépare les suggestions du programme décidé. N’invente aucune réservation, confirmation, référence, dépense ou coordonnée géographique. Ne marque une réservation confirmée que si je le dis explicitement. Réponds en Markdown simple, sans tableau ni bloc de code.
+
+# [Titre du voyage]
+Ville: [Ville connue]
+## Jour 1 — [AAAA-MM-JJ si connue]
+- [HH:MM ou Matin/Après-midi/Soir si connu] : [Activité prévue]
+Adresse: [Adresse fournie, facultative]
+### Suggestions
+- Suggestion: [Idée distincte, non réservée]
+## Notes
+[Inconnues et points à vérifier]
+
+Mon programme à reformater :
+`,
+  en: `Format my itinerary as the Markdown template below for Détours. Use only information I supply. Replace bracketed fields if known; otherwise omit them. Keep unknowns and ambiguities under Notes. Include a date only when explicit, as YYYY-MM-DD; never infer the year. One activity per line, with a 24-hour time or period only if supplied. Optional addresses on separate lines. Keep suggestions separate from decided plans. Never invent bookings, confirmations, references, expenses or geographic coordinates. Mark a booking confirmed only if I explicitly say so. Return plain Markdown without tables or code fences.
+
+# [Trip title]
+City: [Known city]
+## Day 1 — [YYYY-MM-DD if known]
+- [HH:MM or Morning/Afternoon/Evening if known]: [Planned activity]
+Address: [Supplied address, optional]
+### Suggestions
+- Suggestion: [Separate idea, not booked]
+## Notes
+[Unknowns and checks]
+
+My itinerary to reformat:
+`,
+  'zh-CN': `请按照以下 Markdown 模板整理我的行程，以便导入 Détours。仅使用我提供的信息。已知时替换方括号字段，未知则省略。未知或有歧义的信息放入备注。仅在明确提供日期时使用 YYYY-MM-DD，不要推测年份。每行一个活动，仅在已提供时写24小时制时间或时段。地址可选，另起一行。建议与已决定的安排分开。不要编造预订、确认、编号、费用或地理坐标。只有我明确说明已确认预订时才标记确认。输出简单 Markdown，不用表格或代码块。
+
+# [旅行标题]
+城市：[已知城市]
+## 第1天 — [已知时填写 YYYY-MM-DD]
+- [已知时填写 HH:MM 或上午/下午/晚上]：[计划活动]
+地址：[已提供的地址，可选]
+### 建议
+- 建议：[独立建议，未预订]
+## 备注
+[未知信息和待核实事项]
+
+需要整理的行程：
+`,
+  es: `Ordena mi itinerario con esta plantilla Markdown para Détours. Usa solo la información que proporciono. Sustituye los campos entre corchetes si se conocen; si no, omítelos. Conserva las dudas y ambigüedades en Notas. Incluye fechas solo si son explícitas, como AAAA-MM-DD; no deduzcas el año. Una actividad por línea, con hora de 24 h o período solo si se facilita. Dirección opcional en otra línea. Separa sugerencias de planes decididos. No inventes reservas, confirmaciones, referencias, gastos ni coordenadas geográficas. Marca una reserva confirmada solo si lo digo expresamente. Devuelve Markdown sencillo, sin tablas ni bloques de código.
+
+# [Título del viaje]
+Ciudad: [Ciudad conocida]
+## Día 1 — [AAAA-MM-DD si se conoce]
+- [HH:MM o Mañana/Tarde/Noche si se conoce]: [Actividad prevista]
+Dirección: [Dirección facilitada, opcional]
+### Sugerencias
+- Sugerencia: [Idea separada, sin reservar]
+## Notas
+[Dudas y comprobaciones]
+
+Mi itinerario para reformatear:
+`,
+};
+export function externalPlanningPrompt(language: keyof typeof prompts): string { return prompts[language]; }
