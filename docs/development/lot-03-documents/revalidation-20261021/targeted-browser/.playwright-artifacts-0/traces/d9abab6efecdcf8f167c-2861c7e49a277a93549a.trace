 #fff; border: 1px solid #e0e6df; border-radius: 12px; margin: 10px 0; }\r\n.overview-day > div { flex: 1; min-width: 0; }\r\n.overview-day-link { text-align: left; font: inherit; font-weight: 650; border: 0; padding: 6px 0; background: none; color: #24473d; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }\r\n.overview-day p { font-size: .88rem; color: #64746b; margin: 5px 0; }\r\n.overview-date { display: grid; gap: 5px; font-size: .8rem; max-width: 250px; }\r\n.overview-date input { min-height: 44px; padding: 8px 10px; border: 1px solid #bcc9c0; border-radius: 8px; font: inherit; font-size: .95rem; background: white; color: #243d32; max-width: 100%; }\r\n.overview-clear { background: #f2f4ef; color: #425e50; border: 1px solid #d3ded4; border-radius: 8px; padding: 8px 12px; cursor: pointer; }\r\n.trip-overview button:focus-visible, .trip-overview input:focus-visible { outline: 3px solid #b47c39; outline-offset: 3px; }\r\n@media (max-width: 650px) { .overview-day { flex-wrap: wrap; gap: 10px; } .overview-day > div { flex-basis: 100%; } .overview-date { flex: 1; max-width: none; min-width: 0; } .overview-summary { gap: 12px; padding: 16px; } .overview-actions { width: 100%; } .overview-actions button { flex: 1 1 180px; } }\r\n"],["STYLE",{},".map-actions.map-actions { display: grid; grid-template-columns: minmax(0, 1fr) 44px; align-items: start; gap: 0 8px; width: 100%; min-width: 0; max-width: 100%; }\n.map-route { position: relative; margin: 0; min-width: 0; }\n.map-route-toggle { display: flex; align-items: center; gap: 6px; min-height: 44px; padding: 6px 0; color: var(--muted); font-size: 12px; line-height: 1.5; list-style: none; cursor: pointer; }\n.map-route-toggle::-webkit-details-marker, .map-next-route > summary::-webkit-details-marker { display: none; }\n.map-route-toggle:hover, .map-route[open] > .map-route-toggle { color: var(--green); }\n.map-route-toggle span { min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap; }\n.m