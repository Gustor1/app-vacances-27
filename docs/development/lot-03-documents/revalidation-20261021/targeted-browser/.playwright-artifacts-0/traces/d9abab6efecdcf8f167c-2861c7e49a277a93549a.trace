e { outline: 3px solid #bf613d; outline-offset: 4px; }\r\n.trip-map .leaflet-popup-content-wrapper { border-radius: 14px; background: #fffef9; color: #293b2d; }\r\n.trip-map-popup { display: grid; gap: 7px; padding: 3px; max-width: 230px; }\r\n.trip-map-popup strong { font-size: 14px; line-height: 1.4; }\r\n.trip-map-popup span { font-size: 12px; color: #6c7568; }\r\n.trip-map-popup a { color: #43694e; font-weight: 600; font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }\r\n.trip-map-footer { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; padding: 11px 15px; background: #f9faf5; color: #687463; font-size: 11px; line-height: 1.5; border-top: 1px solid #dce4d9; }\r\n.trip-map-legend-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: #688165; }\r\n.trip-map-route-note { flex-basis: 100%; padding-left: 13px; font-size: 10px; }\r\n.trip-map-notice { position: absolute; z-index: 1; top: 14px; left: 14px; right: 14px; padding: 11px 14px; border: 1px solid #d7dfd1; border-radius: 10px; background: #fffef9ed; color: #596650; font-size: 12px; box-shadow: 0 3px 12px #2d3d2510; pointer-events: none; }\r\n.trip-map-fallback { background: #fffaf0; border-top: 1px solid #e8dec8; padding: 12px 15px; color: #766447; font-size: 12px; }\r\n.trip-map-fallback p { margin: 0 0 9px; line-height: 1.5; }\r\n.trip-map-fallback-links { display: flex; gap: 7px 13px; flex-wrap: wrap; max-height: 104px; overflow: auto; }\r\n.trip-map-fallback-links a { color: #43694e; text-underline-offset: 3px; }\r\n@media (max-width: 640px) { .trip-map { min-height: 350px; border-radius: 16px; } .trip-map-stage { min-height: 310px; } .trip-map-footer { font-size: 10px; padding: 10px 12px; } }\r\n\r\n.trip-map .trip-map-city-label { background: #fffef8e8; border: 0; box-shadow: 0 1px 5px #314a3020; border-radius: 5px; color: #40563e; font-family: inherit; font-size: 10px; font-weight: 600; padding: 3px 6px; }\r\n.trip-map .trip-map-city-label::before { display: none; }\r\n\r\n.trip-map-center-marker { background: #84937a; border-style: dashed; }\r\n.trip-map-center-marker span { font-size: 24px; line-height: 21px; }\r\n"],["STYLE",{},".day-preparation{margin:0 0 20px;min-width:0;padding:18px}.day-preparation>summary{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;cursor:pointer;font-weight:650;min-height:44px;align-items:center}.day-preparation>summary>span{font-size:12px;color:var(--muted);overflow-wrap:anywhere}.day-preparation-body{display:grid;gap:16px;margin-top:16px;line-height:1.7;overflow-wrap:anywhere}.day-preparation-body h3{font-size:17px}.day-preparation-body .btn{white-space:normal;min-height:44px;max-width:100%;justify-self:start}.day-timing-form,.day-alternative-form{display:grid;gap:16px}.day-preparation fieldset{min-width:0;padding:14px;border:1px solid var(--line);border-radius:12px}.day-preparation legend{padding:0 6px;max-width:100%;font-weight:600}.day-preparation-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.day-preparation .field{min-width:0;display:grid;gap:6px}.day-preparation input,.day-preparation select{min-width:0;width:100%;min-height:44px;box-sizing:border-box}.day-analysis{padding:14px;background:var(--surface-alt);border-radius:12px}.day-alternative-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.day-alternative-check{display:flex;gap:10px;align-items:center;padding:8px 0;min-height:44px}.day-alternative-check input{width:18px;min-height:18px;flex-shrink:0}.day-alternative-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.day-alternative-comparison>div{padding:14px;border:1px solid var(--line);border-radius:12px;display:grid;gap:12px;align-content:start;min-width:0}.day-alternative-comparison ol{padding-left:22px}.day-timing-sources{font-size:12px}.day-timing-sources:empty{display:none}@media(max-width:600px){.day-preparation-fields,.day-alternative-comp