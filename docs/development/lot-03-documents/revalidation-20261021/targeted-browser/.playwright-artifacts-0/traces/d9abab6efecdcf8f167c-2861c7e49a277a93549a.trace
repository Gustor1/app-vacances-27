.local-status,.journey-switch){border-color:var(--line)}\r\n:root[data-theme=dark] :is(.nav-item,.route-stop,.route-add,.search-box input,.breadcrumb strong,.breadcrumb,.day-tabs button,.page-intro p,.city-heading p,.step-description,.chinese-name,.step-meta,.day-footer,.page-footer,.mini-note p,.journey-switch span,.nav-caption,.sidebar-route-title,.note-saved,.step-address,.field,.muted,.practical-muted,.practical-view .field,.practical-phrase .eyebrow,.overview-day p,.overview-date-hint,.budget-tag,.bonus-description,.bonus-teaser p,.bonus-source-note,.bonus-card-top .eyebrow,.bonus-count,.section-label,.section-label>span,.tools-grid>.panel>p){color:var(--muted)}\r\n:root[data-theme=dark] :is(.city-heading h2>span,.route-stop small,.city-tab small,.count-badge,.bonus-category-icon,.optional-tag){color:var(--muted)}\r\n:root[data-theme=dark] :is(.step-content h4,.bonus-card h3,.practical-card h3,.practical-card h4,.day-heading h3){color:var(--text)}\r\n:root[data-theme=dark] :is(.text-btn,.amap-link,.overview-day-link,.bonus-teaser h3,.practical-chinese,.panel-heading svg,.checklist-row svg){color:var(--green)}\r\n:root[data-theme=dark] :is(.progress-chip,.tag,.count-badge,.notice,.offline-ready,.practical-totals strong,.overview-summary,.practical-phrase.is-large,.booking-tag,.category-visit,.category-walk){background:#2c3f2e;border-color:#46583e;color:#c0d8a7}\r\n:root[data-theme=dark] .notice p{color:inherit}\r\n:root[data-theme=dark] :is(.warning-notice,.trip-map-fallback){background:#3c3024;border-color:#685438;color:#eed3a9}\r\n:root[data-theme=dark] :is(.remember-card,.bonus-teaser){background:#2c3023;border-color:#484c35}\r\n:root[data-theme=dark] :is(.remember-heading h3,.remember-heading>span,.remember-card>p,.bonus-teaser .eyebrow){color:#d0c5a4;border-color:#625c41}\r\n:root[data-theme=dark] :is(.field input,.field textarea,.field select,.remember-card textarea,.overview-date input,.practical-view .field input,.practical-view .field select,.practical-