ht:44px;min-width:44px;margin-top:10px}\r\n .practical-tabs{position:sticky;top:calc(63px + env(safe-area-inset-top));z-index:2;padding:8px 0;background:var(--surface-alt)}\r\n .city-tabs,.day-tabs{scroll-padding-inline:16px;scroll-snap-type:x proximity}.city-tab,.day-tabs>button{scroll-snap-align:nearest}\r\n .topbar .preferences-trigger{width:40px;height:40px}.topbar-actions{min-width:0;flex:1;justify-content:flex-end}.search-box{max-width:205px;width:100%;min-width:0}.search-box input{min-width:0}.breadcrumb{min-width:0}.breadcrumb strong{max-width:130px;overflow:hidden;text-overflow:ellipsis}.topbar{gap:10px}\r\n}\r\n@media(max-width:360px){.breadcrumb strong{max-width:72px}.topbar-actions{flex:1;min-width:0}.search-box{width:100%;min-width:0;max-width:140px}.search-box input{font-size:12px}.topbar-actions{gap:5px}.city-heading{gap:10px}.progress-chip{max-width:80px;flex-shrink:0}.mobile-bottom-nav{padding-left:4px;padding-right:4px}}\r\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}\r\n@media print{.mobile-bottom-nav,.preferences-trigger,.daily-shortcut{display:none!important}:root[data-theme=dark]{color:#172a27;background:white;--text:#172a27;--surface:white;--surface-alt:white;--muted:#46534b;--green:#244c40;--green-dark:#244c40;--line:#b8c5bb}:root[data-theme=dark] body,:root[data-theme=dark] .panel{background:white;color:#172a27}}\r\n.intro-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.intro-actions .daily-shortcut{margin:0}.page-intro>.intro-actions{flex:none}\r\n@media(max-width:760px){.intro-actions{gap:7px}.intro-actions .daily-shortcut{max-width:110px;white-space:normal;line-height:1.35}.page-intro>.intro-actions{flex:0 0 auto;flex-direction:column;align-items:flex-end}.intro-actions .export-button{margin-top:0}.daily-shortcut{font-size:11px}}\r\n:root[data-theme=dark] :is(.add-step,.add-day,.city-add){background:var(--surface-alt);border-color:#687d5a;color:var(--green)}\r\n:root[data-theme=dark] :is(.add-step:hover,.add-day:hover,.city-add:hover){background:var(--selected-surface)}\r\n@media(max-width:360px){.page-intro{flex-wrap:wrap}.page-intro>div:first-child{flex-basis:100%}.page-intro>.intro-actions{width:100%;flex-direction:row;justify-content:flex-start}.intro-actions .daily-shortcut{max-width:none}.page-intro h1{font-size:25px}.page-intro .export-button{font-size:11px;width:auto;padding:9px 12px;gap:7px;height:auto;min-height:40px}}\r\n:root[data-theme=dark] :is(.nav-item:hover,.route-stop:hover,.city-tab:hover,.btn-secondary:hover,.bonus-filters button:hover,.search-results button:hover){background:var(--selected-surface);color:var(--green)}\r\n.city-tab strong{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n\r\n.map-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}.map-actions small{flex-basis:100%;color:var(--muted);line-height:1.5;font-size:10px}.map-actions a,.map-actions button{min-height:36px;display:inline-flex;align-items:center}.map-mode select{min-height:36px;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:6px;font:inherit;font-size:11px}.step-bottom{flex-wrap:wrap}.step-bottom>.map-actions{flex:1 1 240px}\n\n.modal-content{padding:24px 26px;line-height:1.6}\n.modal-content>.editor-form,.modal-content>.bonus-detail,.modal-content>.confirm-dialog,.modal-content>.source-document{padding:0}\n.modal-content>p{margin:0 0 20px}.modal-content>p:last-child{margin-bottom:0}\n.modal-heading h2{min-width:0;overflow-wrap:anywhere;line-height:1.4}.modal-heading .icon-btn{flex-shrink:0}\n.form-actions{flex-wrap:wrap;gap:12px;margin-top:20px}.form-actions .btn{max-width:100%;white-space:normal}\n.journey-switch>div{flex:1;min-width:0}.journey-switch strong{white-space:normal;overflow-wrap:anywhere;line-height:1.45}\n.journey-switch .journey-flag,.journey-switch>svg{flex-shrink:0}\n.route-stop>span:not(.route-dot):not(.sr-only){flex:1;min-width:0;overflow-wrap:anywhere}.route-stop small{flex-shrink:0}\n.city-tab{flex:0 0 auto;min-width:150px;max-width:240px}.city-tab>div{min-width:0}\n.city-tab strong{white-space:normal;overflow:visible;overflow-wrap:anywhere;line-height:1.4}.city-tab small{white-space:normal;line-height:1.4}\n.breadcrumb{min-width:0}.breadcrumb strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.topbar-actions{justify-content:flex-end}\n@media(max-width:760px){.modal-content{padding:20px}.topbar{height:auto;min-height:76px;flex-wrap:wrap;gap:10px;padding-block:12px}.topbar>.breadcrumb{flex:1 1 170px}.topbar-actions{flex:1 1 280px;flex-wrap:wrap;min-width:0}.topbar-actions .search-box{flex:1 1 120px;max-width:210px;min-width:0}}\n"],["STYLE",{},"/* Apple-inspired presentation. Existing travel data and workflows stay in their owners.\r\n * Repeating :root gives this final skin priority over legacy themed :is() selectors. */\r\nhtml:root:root {\r\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;\r\n  font-size: 15px;\r\n  font-optical-sizing: auto;\r\n  line-height: 1.5;\r\n  --surface: #f7f2e9;\r\n  --surface-alt: #e8dfd0;\r\n  --text: #253b32;\r\n  --muted: #596459;\r\n  --text-muted: var(--muted);\r\n  --line: #d3cbbb;\r\n  --green: #3c6e59;\r\n  --green-dark: #305945;\r\n  --selected-surface: #dce6d8;\r\n  --cream: #fff8e8;\r\n  --orange: #a45616;\r\n  --focus: #3c6e59;\r\n  /* Filled controls have their own tokens: dark mode retains its original blue. */\r\n  --action: #3c6e59;\r\n  --action-hover: #305945;\r\n  --on-action: #faf6ee;\r\n  --action-shadow: #3c6e5914;\r\n  --text-selection: #3c6e5933;\r\n  --control-line: #71806f;\r\n  --sidebar: 264px;\r\n  --glass: rgba(247, 242, 233, .86);\r\n  --glass-heavy: rgba(238, 230, 217, .92);\r\n  --glass-chip: rgba(250, 246, 238, .94);\r\n  --liquid: rgba(247, 242, 233, .84);\r\n  --liquid-opaque: rgba(247, 242, 233, .97);\r\n  --liquid-edge: rgba(250, 246, 238, .8);\r\n  --liquid-highlight: rgba(250, 246, 238, .55);\r\n  --header-liquid: rgba(232, 223, 208, .88);\r\n  --header-opaque: rgba(232, 223, 208, .98);\r\n  --field: #f2ebdf;\r\n  --shadow: 0 4px 24px #253b3205, 0 1px 3px #253b3204;\r\n  --floating-shadow: 0 24px 80px #3b352b26, 0 4px 16px #3b352b0d;\r\n  background: var(--surface-alt);\r\n  color: var(--text);\r\n  -webkit-font-smoothing: antialiased;\r\n}\r\nhtml:root:root[data-theme=dark] {\r\n  --surface: #232326;\r\n  --surface-alt: #161618;\r\n  --text: #f5f5f7;\r\n  --muted: #a9a9b2;\r\n  --line: #3b3b41;\r\n  --green: #80baff;\r\n  --green-dark: #a3cfff;\r\n  --selected-surface: #26364b;\r\n  --cream: #343024;\r\n  --orange: #efbe81;\r\n  --focus: #80baff;\r\n  --action: #0071e3;\r\n  --action-hover: #0077ed;\r\n  --on-action: #fff;\r\n  --action-shadow: #0071e314;\r\n  --text-selection: #0071e333;\r\n  --control-line: var(--line);\r\n  --glass: rgba(30, 30, 33, .9);\r\n  --glass-heavy: rgba(37, 37, 42, .94);\r\n  --glass-chip: rgba(35, 35, 38, .96);\r\n  --liquid: rgba(38, 38, 44, .68);\r\n  --liquid-opaque: rgba(38, 38, 43, .96);\r\n  --liquid-edge: rgba(255, 255, 255, .2);\r\n  --liquid-highlight: rgba(255, 255, 255, .09);\r\n  --header-liquid: rgba(22, 22, 24, .68);\r\n  --header-opaque: rgba(22, 22, 24, .96);\r\n  --field: #1c1c1f;\r\n  --shadow: 0 4px 24px #00000014, 0 1px 3px #0000000d;\r\n  --floating-shadow: 0 24px 80px #00000070, 0 4px 16px #00000024;\r\n}\r\nhtml:root:root[data-theme] body { background: var(--surface-alt); color: var(--text); }\r\nhtml:root:root :is(h1, h2, h3, h4, h5, .brand, .shared-trip-stats dd, .shared-step-title h5) {\r\n  font-family: inherit;\r\n  font-optical-sizing: auto;\r\n}\r\nhtml:root:root :is(h1, h2) { letter-spacing: -.035em; line-height: 1.14; font-weight: 700; }\r\nhtml:root:root h3 { letter-spacing: -.018em; font-weight: 650; }\r\nhtml:root:root :is(button, a, input, select, textarea, summary) { -webkit-tap-highlight-color: transparent; }\r\nhtml:root:root :is(button, a, input, select, textarea, summary):focus-visible {\r\n  outline: 3px solid var(--focus); outline-offset: 4px;\r\n}\r\nhtml:root:root :is(button, summary) { touch-action: manipulation; }\r\nhtml:root:root :is(button, .btn, summary):active:not(:disabled) { transform: scale(.975); }\r\nhtml:root:root :is(button, .btn, summary) { transition: background-color 140ms ease, color 140ms ease, box-shadow 140ms ease; }\r\nhtml:root:root button:disabled { opacity: .45; }\r\nhtml:root:root ::selection { background: var(--text-selection); }\r\nhtml:root:root .eyebrow { color: var(--muted); font-size: .67rem; font-weight: 650; letter-spacing: .12em; }\r\nhtml:root:root :is(.muted, .practical-muted, .step-description, .chinese-name, .step-meta, .journey-details, .note-saved, .section-label > span) { color: var(--muted); }\r\nhtml:root:root .muted { font-size: .9rem; }\r\nhtml:root:root .small { font-size: .8rem; }\r\nhtml:root:root :is(.btn, .daily-shortcut) {\r\n  min-height: 44px; border-radius: 999px; padding: .7rem 1.2rem;\r\n  font-size: .85rem; font-weight: 600; gap: .5rem; line-height: 1.45;\r\n}\r\nhtml:root:root[data-theme] .btn-primary { background: var(--action); color: var(--on-action); border-color: transparent; box-shadow: 0 2px 4px var(--action-shadow); }\r\nhtml:root:root[data-theme] .btn-primary:hover:not(:disabled) { background: var(--action-hover); }\r\nhtml:root:root[data-theme] :is(.btn-secondary, .daily-shortcut, .overview-actions button, .overview-clear) {\r\n  background: var(--surface); color: var(--text); border: 1px solid var(--line); box-shadow: none;\r\n}\r\nhtml:root:root[data-theme] :is(.btn-secondary, .daily-shortcut, .overview-actions button, .overview-clear):hover:not(:disabled) { background: var(--selected-surface); }\r\nhtml:root:root[data-theme] :is(.text-btn, .amap-link, .overview-day-link, .source-document a) { color: var(--green); }\r\nhtml:root:root .text-btn { font-size: .83rem; min-height: 36px; gap: .45rem; line-height: 1.5; }\r\nhtml:root:root .icon-btn { min-width: 36px; min-height: 36px; width: 36px; height: 36px; border-radius: 50%; color: var(--muted); }\r\nhtml:root:root[data-theme] :is(.icon-btn, .copy-btn, .heart-btn):hover:not(:disabled) { color: var(--green); background: var(--selected-surface); }\r\nhtml:root:root[data-theme] :is(.panel, .overview-day, .trip-collaboration, .account-panel > section, .share-panel .share-card) {\r\n  background: var(--surface); color: var(--text); border-color: var(--line); border-radius: 22px; box-shadow: var(--shadow);\r\n}\r\nhtml:root:root :is(.panel-heading, .day-heading, .section-header, .currency-heading) h3 { color: var(--text); }\r\nhtml:root:root[data-theme] :is(.field, .practical-view .field) { color: var(--muted); font-size: .85rem; font-weight: 500; gap: .5rem; }\r\nhtml:root:root[data-theme] :is(.field input, .field select, .field textarea, .practical-view .field input, .practical-view .field select, .practical-view .field textarea, .country-picker > input, .remember-card textarea, .overview-date input, .share-link input, .share-row-actions select) {\r\n  background: var(--field); color: var(--text); border: 1px solid var(--control-line);\r\n  border-radius: 12px; min-height: 46px; padding: .8rem .9rem; font-size: 1rem;\r\n  box-shadow: none;\r\n}\r\nhtml:root:root[data-theme] :is(input, textarea)::placeholder { color: var(--muted); opacity: .85; }\r\nhtml:root:root[data-theme] :is(.field input, .field select, .field textarea):focus { border-color: var(--focus); }\r\nhtml:root:root :is(input[type=checkbox], input[type=radio], progress) { accent-color: var(--action); }\r\nhtml:root:root[data-theme] :is(.notice, .overview-summary, .offline-ready, .practical-phrase.is-large, .currency-result) {\r\n  background: var(--selected-surface); border-color: var(--line); color: var(--text); border-radius: 16px;\r\n}\r\nhtml:root:root[data-theme] :is(.warning-notice, .trip-map-fallback) { background: var(--cream); color: var(--orange); border-color: var(--line); }\r\nhtml:root:root[data-theme] :is(.practical-error, .transfer-error) { color: #b3261e; }\r\nhtml:root:root[data-theme=dark] :is(.practical-error, .transfer-error) { color: #ffb4ab; }\r\nhtml:root:root[data-theme] .practical-error { background: var(--cream); }\r\n\r\n/* Library: clear wayfinding, one primary action, room for each journal. */\r\nhtml:root:root .journeys-topbar {\r\n  position: sticky; top: 0; z-index: 100; max-width: none; padding: 1.2rem max(2rem, calc((100vw - 1160px) / 2));\r\n  min-height: 84px; flex-wrap: nowrap; gap: 1rem; background: var(--glass);\r\n  backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);\r\n  box-shadow: 0 10px 20px -20px #14142055;\r\n}\r\nhtml:root:root .brand { color: var(--text); font-size: 1.8rem; letter-spacing: -.07em; gap: .65rem; padding: 0; }\r\nhtml:root:root .brand small { color: var(--muted); font-size: .45rem; letter-spacing: .15em; margin-top: .5rem; }\r\nhtml:root:root[data-theme] .brand-mark {\r\n  background: var(--action); color: var(--on-action); width: 42px; height: 42px; border-radius: 14px;\r\n  box-shadow: inset 0 1px 0 #ffffff26;\r\n}\r\nhtml:root:root[data-theme] .brand-dot { color: var(--green); }\r\nhtml:root:root[data-theme] .brand-mark:has(.brand-icon) { background: var(--brand-surface, #e1d6c4); box-shadow: none; overflow: hidden; }\r\nhtml:root:root .brand-icon { display: block; width: 100%; height: 100%; object-fit: cover; }\r\nhtml:root:root .brand-symbol { display: inline-block; width: 15px; height: 15px; border-radius: 5px; flex-shrink: 0; vertical-align: middle; }\r\nhtml:root:root .journeys-topbar-actions { width: auto; display: flex; align-items: center; flex-wrap: nowrap; gap: .75rem; }\r\nhtml:root:root .preferences-trigger { width: 44px; height: 44px; background: var(--surface); border: 1px solid var(--line); }\r\nhtml:root:root .account-button { min-height: 44px; font-size: .83rem; border-radius: 999px; padding: .6rem 1rem; }\r\nhtml:root:root .journeys-main { max-width: 1240px; padding: 3.5rem 40px 2rem; }\r\nhtml:root:root .journeys-intro { gap: 2rem; margin-bottom: 2.5rem; align-items: center; }\r\nhtml:root:root .journeys-intro h1 { font-size: clamp(2.5rem, 4.3vw, 4rem); margin: .75rem 0 1rem; letter-spacing: -.045em; }\r\nhtml:root:root .journeys-intro .muted { font-size: 1.05rem; line-height: 1.7; max-width: 600px; }\r\nhtml:root:root .journeys-intro > .btn { flex-shrink: 0; }\r\nhtml:root:root .collection-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }\r\nhtml:root:root .journeys-tabs {\r\n  display: inline-flex; gap: 4px; padding: 5px; margin: 0; border-radius: 999px;\r\n  background: var(--glass-heavy); border: 1px solid var(--line); flex-wrap: nowrap;\r\n}\r\nhtml:root:root[data-theme] .journeys-tabs button {\r\n  display: inline-flex; justify-content: center; align-items: center; gap: .5rem;\r\n  min-height: 44px; padding: .65rem 1.2rem; font-size: .88rem; font-weight: 600;\r\n  border: 0; border-radius: 999px; background: transparent; color: var(--muted);\r\n}\r\nhtml:root:root[data-theme] .journeys-tabs button[aria-selected=true] { background: var(--surface); color: var(--text); box-shadow: 0 2px 8px #00000012; }\r\nhtml:root:root .collection-summary { display: flex; gap: 1.3rem; flex-wrap: wrap; color: var(--muted); font-size: .8rem; }\r\nhtml:root:root .collection-summary span { display: inline-flex; gap: .4rem; align-items: center; }\r\nhtml:root:root .collection-summary strong { font-weight: 650; color: var(--text); }\r\nhtml:root:root .home-sync-status { padding: 1rem 1.3rem; border-radius: 16px; border-color: var(--line); background: var(--surface); box-shadow: none; margin-bottom: 1.7rem; gap: 1rem; }\r\nhtml:root:root .home-sync-status strong { font-size: .82rem; }\r\nhtml:root:root .home-sync-status p { color: var(--muted); font-size: .8rem; line-height: 1.6; margin-top: .25rem; }\r\nhtml:root:root .home-sync-status > div { min-width: 0; }\r\nhtml:root:root .journeys-filters { justify-content: flex-start; gap: 1rem; margin-bottom: 1.5rem; }\r\nhtml:root:root .journeys-filters .field { flex: 0 1 240px; width: auto; }\r\nhtml:root:root .journeys-filters select { width: 100%; max-width: none; background: var(--surface); min-height: 44px; font-size: .88rem; }\r\nhtml:root:root .journeys-grid { gap: 1.5rem; align-items: start; }\r\nhtml:root:root .journey-card { border-radius: 24px; }\r\nhtml:root:root .journey-cover { height: 210px; background: var(--selected-surface); }\r\nhtml:root:root .journey-cover img { object-fit: cover; }\r\nhtml:root:root .journey-cover:active { transform: none; }\r\nhtml:root:root .journey-cover-tag {\r\n  background: var(--glass-chip); color: var(--text); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);\r\n  padding: .55rem .8rem; font-size: .75rem; left: 20px; bottom: 18px;\r\n  border: 1px solid #ffffff40; box-shadow: 0 2px 8px #0000000a;\r\n}\r\nhtml:root:root .journey-card-body { padding: 1.5rem; }\r\nhtml:root:root .journey-title h2 { font-size: 1.55rem; line-height: 1.23; letter-spacing: -.03em; }\r\nhtml:root:root .journey-title > svg { color: var(--green); }\r\nhtml:root:root .journey-status { background: var(--selected-surface); color: var(--green); font-size: .7rem; font-weight: 600; padding: .35rem .65rem; margin-bottom: .8rem; }\r\nhtml:root:root .journey-card-body > .muted { font-size: .9rem; margin: .85rem 0 1.25rem; min-height: 0; }\r\nhtml:root:root .journey-details { font-size: .76rem; gap: .9rem; }\r\nhtml:root:root .journey-countries { font-size: .8rem; }\r\nhtml:root:root .journey-card-actions { border-color: var(--line); gap: .5rem 1rem; flex-wrap: wrap; margin-top: 1rem; padding-top: .75rem; }\r\nhtml:root:root .journey-card-actions .text-btn { font-size: .76rem; min-height: 36px; }\r\nhtml:root:root[data-theme] .journeys-empty {\r\n  padding: 4rem 2rem; background: var(--surface); position: relative; overflow: hidden; isolation: isolate;\r\n}\r\nhtml:root:root .journeys-empty::before {\r\n  content: ''; position: absolute; inset: 0; z-index: -1;\r\n  background: url('/travel-landscape.svg') center / cover; opacity: .06;\r\n}\r\nhtml:root:root .journeys-empty > svg { color: var(--green); padding: 1rem; box-sizing: content-box; border-radius: 24px; background: var(--selected-surface); width: 36px; height: 36px; }\r\nhtml:root:root .journeys-empty h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }\r\nhtml:root:root .journeys-empty p { font-size: 1rem; color: var(--muted); max-width: 520px; }\r\nhtml:root:root .journeys-import { margin-top: 2rem; padding: 2rem; gap: 2rem; background: var(--surface); }\r\nhtml:root:root .journeys-import h2 { font-size: 1.55rem; margin: .6rem 0 .75rem; }\r\nhtml:root:root .journeys-import .muted { font-size: .86rem; }\r\nhtml:root:root .journeys-import .small { margin-top: .5rem; font-size: .75rem; }\r\nhtml:root:root .journeys-import-actions { gap: .65rem; }\r\nhtml:root:root .page-footer { border-color: var(--line); color: var(--muted); font-size: .72rem; margin-top: 2.5rem; padding: 1.5rem 0; }\r\nhtml:root:root .page-footer > span { font-size: inherit; }\r\n\r\n/* Trip workspace: structural glass, solid content, consistent controls. */\r\nhtml:root:root[data-theme] .sidebar {\r\n  padding: 2rem 1rem 1.25rem; background: var(--glass-heavy); border-right: 1px solid var(--line);\r\n  backdrop-filter: blur(24px) saturate(140%); -webkit-backdrop-filter: blur(24px) saturate(140%); box-shadow: none;\r\n}\r\nhtml:root:root .sidebar .brand { margin: 0 .75rem 2rem; }\r\nhtml:root:root[data-theme] .journey-switch { border-radius: 16px; padding: 1rem .85rem; background: var(--surface); border-color: var(--line); margin-bottom: 1.75rem; gap: .65rem; }\r\nhtml:root:root .journey-switch strong { font-size: .86rem; color: var(--text); }\r\nhtml:root:root .journey-switch div span { font-size: .73rem; color: var(--muted); }\r\nhtml:root:root[data-theme] .journey-flag { color: var(--green); background: var(--selected-surface); border-radius: 10px; }\r\nhtml:root:root .nav-caption { color: var(--muted); letter-spacing: .1em; font-size: .67rem; margin-left: .85rem; }\r\nhtml:root:root[data-theme] .nav-item { color: var(--muted); border-radius: 12px; min-height: 46px; padding: .85rem; font-size: .88rem; gap: .7rem; }\r\nhtml:root:root[data-theme] .nav-item.active { color: var(--green); background: var(--surface); box-shadow: 0 2px 8px #00000006; font-weight: 650; }\r\nhtml:root:root[data-theme] .nav-item:hover:not(.active) { background: var(--selected-surface); color: var(--green); }\r\nhtml:root:root .nav-dot { background: var(--action); }\r\nhtml:root:root .nav-item svg { width: 19px; height: 19px; }\r\nhtml:root:root .sidebar-route { margin: 1.8rem .85rem; }\r\nhtml:root:root .sidebar-route-title { color: var(--muted); font-size: .65rem; letter-spacing: .09em; }\r\nhtml:root:root[data-theme] .route-stop { color: var(--muted); min-height: 44px; font-size: .81rem; }\r\nhtml:root:root[data-theme] .route-stop.selected { color: var(--green); }\r\nhtml:root:root .route-dot { background: var(--surface); border-color: var(--muted); }\r\nhtml:root:root .route-stop.selected .route-dot { background: var(--action); border-color: var(--action); box-shadow: 0 0 0 4px var(--selected-surface); }\r\nhtml:root:root .route-stop:not(:last-of-type)::after { border-color: var(--line); }\r\nhtml:root:root .route-stop small { font-size: .7rem; }\r\nhtml:root:root .route-add { color: var(--green); font-size: .8rem; min-height: 44px; }\r\nhtml:root:root[data-theme] .mini-note { background: var(--surface); border-radius: 16px; padding: 1.1rem; }\r\nhtml:root:root .mini-note p { color: var(--muted); font-size: .77rem; }\r\nhtml:root:root[data-theme] .mini-note > span { color: var(--green); }\r\nhtml:root:root .local-status { color: var(--muted); font-size: .67rem; line-height: 1.6; }\r\nhtml:root:root[data-theme] .topbar {\r\n  position: sticky; top: 0; z-index: 90; height: auto; min-height: 80px; padding: 1rem 2rem;\r\n  background: var(--glass); backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%);\r\n  border-bottom: 0; box-shadow: 0 10px 20px -20px #14142055; gap: 1rem;\r\n}\r\nhtml:root:root .breadcrumb { color: var(--muted); font-size: .82rem; gap: .5rem; }\r\nhtml:root:root[data-theme] .breadcrumb strong { color: var(--text); font-weight: 600; }\r\nhtml:root:root .topbar-actions { gap: .7rem; }\r\nhtml:root:root[data-theme] .search-box { background: var(--field); color: var(--muted); height: 44px; border-color: var(--line); border-radius: 999px; width: 270px; }\r\nhtml:root:root .search-box input { color: var(--text); font-size: .8rem; }\r\nhtml:root:root .search-box input::placeholder { color: var(--muted); }\r\nhtml:root:root .search-box:focus-within { outline: 3px solid var(--focus); outline-offset: 3px; }\r\nhtml:root:root .search-shortcut { font-size: 18px; }\r\nhtml:root:root .workspace > main { max-width: 1480px; padding: 2.5rem 2rem 0; }\r\nhtml:root:root .page-intro { margin-bottom: 2rem; }\r\nhtml:root:root .page-intro h1 { font-size: clamp(2rem, 3vw, 2.7rem); }\r\nhtml:root:root[data-theme] .page-intro p { font-size: .93rem; color: var(--muted); }\r\nhtml:root:root .intro-actions { gap: .6rem; }\r\nhtml:root:root .intro-actions .btn { font-size: .8rem; }\r\nhtml:root:root .hero { height: 300px; border-radius: 26px; margin-bottom: 2rem; background: #244c40; }\r\nhtml:root:root .hero-copy { padding: 2.5rem; }\r\nhtml:root:root .hero.custom-hero .hero-copy { height: 100%; background: linear-gradient(90deg, #0c172dd9, #0c172d12); }\r\nhtml:root:root .hero h2, html:root:root .hero.custom-hero h2 { font-family: inherit; font-size: clamp(2rem, 3.5vw, 3.2rem); letter-spacing: -.04em; line-height: 1.13; color: #fff; }\r\nhtml:root:root .hero p { color: #f4f6facf; font-size: .95rem; max-width: 530px; }\r\nhtml:root:root .hero-pill { font-size: .65rem; color: #fff; letter-spacing: .1em; padding: .5rem .8rem; background: #ffffff1a; border-color: #ffffff40; }\r\nhtml:root:root .hero-stats { font-size: .82rem; color: #f4f6fa; gap: 1.25rem; }\r\nhtml:root:root .hero-stamp { border-color: #ffffff66; color: #fff; }\r\nhtml:root:root .section-label h2 { font-size: 1rem; letter-spacing: -.02em; }\r\nhtml:root:root .section-label > span { font-size: .8rem; }\r\nhtml:root:root .cities-section { margin-bottom: 2rem; }\r\nhtml:root:root .city-tabs { gap: .65rem; padding: 4px 4px 8px; }\r\n@media (max-width: 760px) {\r\n  /* Match the mobile main padding instead of the old fixed 20px bleed. */\r\n  html:root:root .city-tabs { margin-right: -1.1rem; }\r\n}\r\nhtml:root:root[data-theme] .city-tab { border-radius: 16px; padding: 1rem; color: var(--text); background: var(--surface); border-color: var(--line); min-width: 160px; }\r\nhtml:root:root[data-theme] .city-tab.active { background: var(--selected-surface); color: var(--green); border-color: var(--green); box-shadow: none; }\r\nhtml:root:root[data-theme] .city-tab:hover { background: var(--selected-surface); }\r\nhtml:root:root .city-tab strong { font-size: .87rem; font-weight: 600; }\r\nhtml:root:root .city-tab small { font-size: .75rem; color: var(--muted); }\r\nhtml:root:root .city-tab-number { font-size: .73rem; color: var(--muted); }\r\nhtml:root:root .city-active-dot { background: var(--action); width: 5px; height: 5px; }\r\nhtml:root:root .city-add { color: var(--green); border-color: var(--line); border-radius: 16px; min-width: 48px; background: var(--surface); }\r\nhtml:root:root .city-heading h2 { font-size: 2rem; }\r\nhtml:root:root .city-heading p { color: var(--muted); font-size: .88rem; }\r\nhtml:root:root[data-theme] .progress-chip { color: var(--green); background: var(--selected-surface); font-size: .75rem; padding: .65rem .85rem; }\r\nhtml:root:root .planning-grid { grid-template-columns: minmax(0, 1fr) minmax(290px, 32%); gap: 1.5rem; }\r\nhtml:root:root .planning-aside { gap: 1.25rem; }\r\nhtml:root:root .day-tabs { gap: .4rem; margin-bottom: 1rem; padding: 4px 2px; }\r\nhtml:root:root[data-theme] .day-tabs button { border-radius: 999px; background: var(--surface); color: var(--muted); border-color: var(--line); min-height: 44px; font-size: .8rem; padding: .65rem 1.1rem; }\r\nhtml:root:root[data-theme] .day-tabs button.active { background: var(--action); border-color: transparent; color: var(--on-action); }\r\nhtml:root:root .day-panel { padding: 1.75rem 1.75rem 0; }\r\nhtml:root:root .day-heading { margin-bottom: 2rem; }\r\nhtml:root:root .day-heading h3 { font-size: 1.35rem; letter-spacing: -.025em; }\r\nhtml:root:root .day-heading .eyebrow { font-size: .7rem; }\r\nhtml:root:root .step-card { gap: 1rem; border-radius: 12px; }\r\nhtml:root:root .timeline-rail { width: 36px; }\r\nhtml:root:root[data-theme] .step-check { width: 36px; height: 36px; background: var(--surface); color: var(--green); border-color: var(--line); font-size: .8rem; }\r\nhtml:root:root[data-theme] .step-check.checked { background: var(--action); color: var(--on-action); border-color: transparent; }\r\nhtml:root:root .timeline-rail > span { border-color: var(--line); background: transparent; }\r\nhtml:root:root .step-content { padding-bottom: 2rem; }\r\nhtml:root:root[data-theme] .step-content h4 { color: var(--text); font-size: 1.07rem; line-height: 1.5; }\r\nhtml:root:root .step-description { font-size: .93rem; line-height: 1.7; margin-top: .5rem; }\r\nhtml:root:root .step-meta { font-size: .72rem; gap: .5rem; min-height: 36px; }\r\nhtml:root:root .category { font-size: .68rem; padding: .25rem .5rem; border-radius: 6px; }\r\nhtml:root:root .chinese-name { font-size: .8rem; }\r\nhtml:root:root .step-actions { opacity: 1; }\r\nhtml:root:root .step-actions .icon-btn { width: 36px; height: 40px; }\r\nhtml:root:root .step-content .map-actions { font-size: .8rem; }\r\nhtml:root:root .map-actions .map-mode select { background: var(--field); border-color: var(--line); border-radius: 8px; font-size: .76rem; color: var(--text); }\r\nhtml:root:root .map-actions small { color: var(--muted); font-size: .68rem; }\r\nhtml:root:root[data-theme] .add-step { background: var(--surface-alt); color: var(--green); border-color: var(--line); border-radius: 14px; min-height: 48px; font-size: .83rem; }\r\nhtml:root:root .day-footer { font-size: .7rem; color: var(--muted); padding: 1rem 0; border-color: var(--line); }\r\nhtml:root:root .panel-heading h3 { font-size: .93rem; font-weight: 650; }\r\nhtml:root:root[data-theme] .panel-heading svg { color: var(--green); }\r\nhtml:root:root .map-panel > .panel-heading { padding: 1.25rem; }\r\nhtml:root:root[data-theme] .remember-card { padding: 1.4rem; background: var(--cream); border-color: var(--line); border-radius: 22px; }\r\nhtml:root:root[data-theme] .remember-heading h3, html:root:root[data-theme] .remember-heading > span { color: var(--orange); font-size: .95rem; }\r\nhtml:root:root[data-theme] .remember-card > p { color: var(--muted); font-size: .87rem; border-color: var(--line); }\r\nhtml:root:root .remember-card textarea { font-size: .93rem; }\r\nhtml:root:root[data-theme] .bonus-teaser { border-radius: 22px; background: var(--surface); border-color: var(--line); padding: 1.5rem; }\r\nhtml:root:root[data-theme] .bonus-teaser h3 { color: var(--text); font-size: 1.05rem; }\r\nhtml:root:root .bonus-teaser p { color: var(--muted); font-size: .87rem; }\r\nhtml:root:root .bonus-teaser .text-btn { font-size: .83rem; }\r\nhtml:root:root .section-header h1 { font-size: 2.3rem; }\r\nhtml:root:root .section-header h2 { font-size: 1.9rem; }\r\nhtml:root:root .bonus-filters { gap: .5rem; }\r\nhtml:root:root[data-theme] :is(.bonus-filters button, .practical-tabs button) { background: var(--surface); color: var(--muted); border-color: var(--line); border-radius: 999px; min-height: 44px; font-size: .86rem; padding: .65rem 1rem; }\r\nhtml:root:root[data-theme] :is(.bonus-filters button.active, .bonus-filters .favorites-filter.active, .practical-tabs button[aria-selected=true]) { background: var(--action); color: var(--on-action); border-color: transparent; }\r\nhtml:root:root .bonus-card { padding: 1.5rem; }\r\nhtml:root:root[data-theme] .bonus-card h3 { color: var(--text); font-size: 1.2rem; }\r\nhtml:root:root .bonus-description { font-size: .93rem; color: var(--muted); }\r\nhtml:root:root .bonus-card-top .eyebrow { color: var(--muted); font-size: .68rem; }\r\nhtml:root:root .practical-card { padding: 1.6rem; gap: 1rem; }\r\nhtml:root:root .practical-card h3 { font-size: 1.2rem; }\r\nhtml:root:root .practical-card h4 { font-size: 1.15rem; }\r\nhtml:root:root .practical-view .btn { font-size: .83rem; }\r\nhtml:root:root .practical-tabs { gap: .5rem; }\r\nhtml:root:root .practical-tabs button { line-height: 1.4; }\r\nhtml:root:root[data-theme] .practical-totals strong { color: var(--green); background: var(--selected-surface); border-radius: 14px; }\r\nhtml:root:root .practical-list > li { border-color: var(--line); padding: 1rem 0; }\r\nhtml:root:root .practical-list { font-size: .93rem; }\r\nhtml:root:root[data-theme] .practical-chinese { color: var(--green); }\r\nhtml:root:root .personal-expense-total { background: var(--surface-alt); border-color: var(--line); border-radius: 16px; }\r\nhtml:root:root .overview-summary { padding: 1.5rem; gap: 1.3rem; }\r\nhtml:root:root .overview-summary progress { accent-color: var(--action); }\r\nhtml:root:root .overview-day { padding: 1.3rem; margin: .75rem 0; }\r\nhtml:root:root .overview-actions button, html:root:root .overview-clear { border-radius: 999px; font-size: .85rem; }\r\nhtml:root:root[data-theme] .overview-date-hint, html:root:root[data-theme] .overview-day p { color: var(--muted); }\r\nhtml:root:root .overview-day-link { text-decoration: none; font-size: 1rem; }\r\nhtml:root:root .overview-day-link:hover { text-decoration: underline; }\r\nhtml:root:root .offline-status { border-radius: 20px; padding: 1.5rem; }\r\nhtml:root:root .tools-grid > .panel { padding: 1.5rem; }\r\nhtml:root:root .tools-grid > .panel > p { color: var(--muted); }\r\nhtml:root:root .transfer-card { border-color: var(--line); }\r\nhtml:root:root .transfer-confirm { background: var(--cream); border-radius: 12px; }\r\nhtml:root:root .checklist-row { font-size: .93rem; }\r\nhtml:root:root[data-theme] .search-results { background: var(--surface); border-color: var(--line); border-radius: 20px; box-shadow: var(--floating-shadow); }\r\nhtml:root:root[data-theme] .search-result { background: var(--surface); color: var(--text); }\r\nhtml:root:root[data-theme] .search-result:hover { background: var(--selected-surface); }\r\nhtml:root:root[data-theme] .toast { background: var(--glass-chip); color: var(--text); border-color: var(--line); border-radius: 999px; padding: 1rem 1.4rem; font-size: .87rem; box-shadow: var(--floating-shadow); }\r\n\r\n/* World and sharing use the same material and typography as private journals. */\r\nhtml:root:root .world-heading h2 { font-size: 2.2rem; }\r\nhtml:root:root .world-map-panel { padding: .7rem; border-radius: 24px; overflow: hidden; }\r\nhtml:root:root .world-map { border-radius: 18px; background: var(--surface-alt); }\r\nhtml:root:root .world-legend { font-size: .8rem; padding: 1.2rem .6rem; }\r\nhtml:root:root .world-country { border-radius: 18px; padding: 1.2rem; color: var(--text); min-height: 100px; }\r\nhtml:root:root .world-country:hover { background: var(--selected-surface); }\r\nhtml:root:root .world-country strong { font-size: .95rem; }\r\nhtml:root:root .world-country span { color: var(--muted); font-size: .8rem; }\r\nhtml:root:root .country-picker { border-color: var(--line); border-radius: 16px; padding: 1.2rem; }\r\nhtml:root:root .country-options label { color: var(--text); border-radius: 8px; }\r\nhtml:root:root .country-options label:hover { background: var(--selected-surface); }\r\nhtml:root:root .country-selected button { background: var(--selected-surface); color: var(--green); border-color: var(--line); border-radius: 999px; }\r\nhtml:root:root .journeys-recovery { border-radius: 22px; }\r\nhtml:root:root .journeys-recovery-item { border-color: var(--line); background: var(--surface-alt); border-radius: 16px; }\r\nhtml:root:root .trip-collaboration { padding: 1rem 1.4rem; display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }\r\nhtml:root:root .trip-collaboration-heading { flex: 1; align-items: center; gap: 1rem; }\r\nhtml:root:root .trip-collaboration-heading > div:first-child { flex: 1 1 180px; }\r\nhtml:root:root .trip-access-badge { margin-bottom: 0; }\r\nhtml:root:root .trip-collaboration-heading:has(p) .trip-access-badge { margin-bottom: .5rem; }\r\nhtml:root:root .trip-access-badge { color: var(--green); }\r\nhtml:root:root .trip-collaboration p { color: var(--muted); font-size: .8rem; }\r\nhtml:root:root .trip-sync-row { border-color: var(--line); border-top: 0; border-left: 1px solid var(--line); padding: 0 0 0 1rem; gap: 1rem; }\r\nhtml:root:root .account-menu { background: var(--glass-heavy); border-color: var(--line); border-radius: 20px; padding: .6rem; box-shadow: var(--floating-shadow); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); transform-origin: top right; }\r\nhtml:root:root .account-menu-heading { border-color: var(--line); }\r\nhtml:root:root .account-menu > button { border-radius: 12px; font-size: .85rem; }\r\nhtml:root:root .share-panel h3 { font-size: 1.2rem; }\r\nhtml:root:root .share-panel p { font-size: .9rem; }\r\nhtml:root:root .share-panel .btn, html:root:root .share-panel .text-btn { font-size: .83rem; }\r\nhtml:root:root .share-help { border-color: var(--line); background: var(--surface-alt); border-radius: 16px; }\r\nhtml:root:root .share-panel .share-create { background: var(--surface-alt); }\r\nhtml:root:root .share-role { color: var(--green); background: var(--selected-surface); }\r\nhtml:root:root .share-intro-icon { border-radius: 16px; }\r\nhtml:root:root .read-only-trip .shared-trip-header { border-radius: 26px; }\r\nhtml:root:root .shared-trip-stats > div, html:root:root .conflict-choice { background: var(--surface-alt); border-color: var(--line); border-radius: 16px; }\r\nhtml:root:root .shared-trip-stats dd { font-weight: 700; letter-spacing: -.03em; }\r\nhtml:root:root .read-only-trip .shared-steps > li { background: var(--surface-alt); border-color: var(--line); border-radius: 16px; }\r\nhtml:root:root .shared-city-number { background: var(--selected-surface); color: var(--green); }\r\nhtml:root:root[data-theme] .trip-map { border-color: var(--line); border-radius: 20px; }\r\nhtml:root:root[data-theme] :is(.trip-map-footer, .trip-map-notice, .trip-map .leaflet-popup-content-wrapper, .trip-map .leaflet-popup-tip, .trip-map .leaflet-control-zoom a) { background: var(--surface); color: var(--text); border-color: var(--line); }\r\nhtml:root:root .mini-map .trip-map { border: 0; border-radius: 0; }\r\n\r\n/* Linen / sage light theme. Keep functional outlines distinct from decorative dividers. */\r\nhtml:root:root[data-theme=light] :is(.journeys-tabs, .theme-options label, .language-options label) { background: var(--surface-soft, #eee6d9); }\r\nhtml:root:root[data-theme=light] :is(select, select option, select optgroup) { background-color: var(--field); color: var(--text); }\r\nhtml:root:root[data-theme=light] select option:checked { background-color: var(--selected-surface); color: var(--green-dark); }\r\nhtml:root:root[data-theme=light] :is(.account-menu, .search-results) { background: var(--field); }\r\nhtml:root:root[data-theme=light] :is(.account-menu > button:hover, .account-menu > button:focus-visible, .search-result:hover) { background: var(--selected-surface); }\r\nhtml:root:root[data-theme=light] :is(.field input, .field select, .field textarea, .search-box, .map-mode select, .country-picker > input, .overview-date input, .share-link input, .share-row-actions select, .remember-card textarea) { border-color: var(--control-line); }\r\nhtml:root:root[data-theme=light] :is(.btn-secondary, .daily-shortcut, .overview-actions button, .overview-clear, .preferences-trigger, .city-tab, .day-tabs button, .bonus-filters button, .practical-tabs button, .step-check, .country-selected button) { border-color: var(--control-line); }\r\nhtml:root:root[data-theme=light] :is(.day-tabs button.active, .step-check.checked, .bonus-filters button.active, .practical-tabs button[aria-selected=true]) { border-color: transparent; }\r\nhtml:root:root[data-theme=light] :is(input, textarea)::placeholder { opacity: 1; }\r\nhtml:root:root[data-theme=light] :is(.day-date, .step-address, .address-missing, .bonus-source-note, .nav-caption, .day-footer) { color: var(--muted); }\r\nhtml:root:root[data-theme=light] :is(.search-box, .theme-options label, .language-options label):focus-within { border-color: var(--focus); }\r\nhtml:root:root[data-theme=light] .hero.custom-hero .hero-copy { background: linear-gradient(90deg, #253b32e6, #253b3212); }\r\nhtml:root:root[data-theme=light] .hero :is(h2, p, .hero-stats, .hero-pill, .hero-stamp) { color: #faf6ee; }\r\n\r\n/* Modal motion is driven by a retargetable spring; the grabber tracks the pointer 1:1. */\r\nhtml:root:root .modal-backdrop { background: transparent; padding: 2rem; backdrop-filter: none; isolation: isolate; }\r\nhtml:root:root .modal-backdrop::before { content: ''; position: absolute; inset: 0; background: #08081266; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); opacity: var(--scrim-opacity, 1); z-index: -1; }\r\nhtml:root:root[data-theme] .modal { background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 28px; box-shadow: var(--floating-shadow); max-height: calc(100dvh - 4rem); width: min(600px, 100%); max-width: none; display: flex; flex-direction: column; overflow: hidden; }\r\nhtml:root:root[data-theme] .modal.modal-wide { width: min(960px, 100%); }\r\nhtml:root:root[data-theme] .modal-heading { background: var(--surface); border-color: var(--line); padding: 1.5rem 1.75rem; flex-shrink: 0; position: relative; }\r\nhtml:root:root .modal-heading h2 { font-size: 1.55rem; line-height: 1.3; letter-spacing: -.03em; }\r\nhtml:root:root .modal-heading .icon-btn { background: var(--surface-alt); }\r\nhtml:root:root .modal-content { padding: 1.75rem; overflow-y: auto; min-height: 0; overscroll-behavior: contain; }\r\nhtml:root:root .editor-form { padding: 1.75rem; }\r\nhtml:root:root .modal-content > .editor-form { padding: 0; }\r\nhtml:root:root .form-actions { gap: .75rem; }\r\nhtml:root:root .sheet-grabber { display: none; }\r\nhtml:root:root[data-theme] .preferences-dialog { background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 28px; padding: 1.75rem; box-shadow: var(--floating-shadow); max-width: calc(100vw - 2rem); }\r\nhtml:root:root .preferences-dialog::backdrop { background: #08081266; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }\r\nhtml:root:root .preferences-dialog h2 { font-size: 1.8rem; }\r\nhtml:root:root .preferences-dialog fieldset { border-color: var(--line); }\r\nhtml:root:root .preferences-dialog legend { color: var(--text); font-size: .95rem; }\r\nhtml:root:root[data-theme] :is(.theme-options label, .language-options label) { background: var(--surface-alt); color: var(--text); border-color: var(--line); border-radius: 16px; }\r\nhtml:root:root[data-theme] :is(.theme-options label.selected, .language-options label.selected) { background: var(--selected-surface); color: var(--green); border-color: var(--green); }\r\nhtml:root:root .preferences-save-note { color: var(--muted); font-size: .8rem; }\r\nhtml:root:root .preferences-dialog label:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; }\r\n\r\n/* Liquid Glass: tinted material, a light-catching edge, and stronger opacity on scroll. */\r\nhtml:root:root[data-theme] :is(.topbar, .journeys-topbar, .mobile-bottom-nav) {\r\n  background-color: var(--liquid);\r\n  background-image: linear-gradient(145deg, var(--liquid-highlight), transparent 45%, #ffffff04);\r\n  backdrop-filter: blur(26px) saturate(180%);\r\n  -webkit-backdrop-filter: blur(26px) saturate(180%);\r\n  box-shadow: inset 0 1px 0 var(--liquid-edge), 0 8px 24px -18px #10102038;\r\n  transition: background-color 160ms ease, box-shadow 160ms ease;\r\n}\r\nhtml:root:root[data-theme][data-scrolled=true] :is(.topbar, .journeys-topbar, .mobile-bottom-nav) {\r\n  background-color: var(--liquid-opaque);\r\n  box-shadow: inset 0 1px 0 var(--liquid-edge), 0 8px 26px -16px #10102055;\r\n}\r\n\r\n/* One continuous material through the iPhone safe area, with no etched top edge. */\r\nhtml:root:root[data-theme] :is(.topbar, .journeys-topbar) {\r\n  padding-top: calc(1rem + env(safe-area-inset-top));\r\n  padding-left: max(2rem, env(safe-area-inset-left));\r\n  padding-right: max(2rem, env(safe-area-inset-right));\r\n  background-color: var(--header-liquid);\r\n  background-image: none;\r\n  border: 0;\r\n  box-shadow: none;\r\n}\r\nhtml:root:root[data-theme] .journeys-topbar {\r\n  padding-inline: max(2rem, calc((100vw - 1160px) / 2), env(safe-area-inset-left)) max(2rem, calc((100vw - 1160px) / 2), env(safe-area-inset-right));\r\n}\r\nhtml:root:root[data-theme][data-scrolled=true] :is(.topbar, .journeys-topbar) {\r\n  background-color: var(--header-opaque);\r\n  box-shadow: none;\r\n}\r\nhtml:root:root .app-update {\r\n  position: fixed; z-index: 95; bottom: calc(1rem + env(safe-area-inset-bottom));\r\n  left: 50%; transform: translateX(-50%); width: max-content;\r\n  max-width: calc(100% - 2rem - env(safe-area-inset-left) - env(safe-area-inset-right));\r\n  display: flex; align-items: center; gap: 1rem; padding: .8rem 1rem;\r\n  background: var(--surface); border: 1px solid var(--line); border-radius: 22px;\r\n  color: var(--text); box-shadow: var(--floating-shadow); font-size: .85rem;\r\n}\r\nhtml:root:root .app-update .btn { flex-shrink: 0; }\r\nhtml:root:root :is(.sidebar nav.glass-selection-group, .journeys-tabs.glass-selection-group) { position: relative; }\r\nhtml:root:root .glass-selection-group { isolation: isolate; }\r\nhtml:root:root .glass-selection-group > button { position: relative; z-index: 1; transition: color 120ms ease; }\r\nhtml:root:root .glass-selection {\r\n  --glass-radius: 999;\r\n  position: absolute; top: 0; left: 0; z-index: 0; pointer-events: none; opacity: 0;\r\n  border-radius: 999px; transform-origin: top left;\r\n  background: linear-gradient(145deg, var(--liquid-highlight), transparent 55%), var(--surface);\r\n  border: 1px solid var(--liquid-edge);\r\n  box-shadow: inset 0 1px 1px var(--liquid-edge), inset 0 -1px 2px #00000008, 0 3px 10px #00000012;\r\n}\r\nhtml:root:root .sidebar .glass-selection { --glass-radius: 12; border-radius: 12px; }\r\nhtml:root:root[data-theme] .glass-selection-group[data-glass-ready] > button:is([aria-current=page], [aria-selected=true]) { background: transparent; box-shadow: none; }\r\nhtml:root:root[data-theme] .glass-selection-group > button:active { background: var(--selected-surface); }\r\n\r\n@media (max-width: 1100px) {\r\n  html:root:root .account-button { width: 44px; min-width: 44px; height: 44px; padding: 0; justify-content: center; gap: 0; }\r\n  html:root:root .account-button :is(.account-button-label, .account-button-chevron) { display: none; }\r\n}\r\n\r\n@media (max-width: 1150px) {\r\n  html:root:root .planning-grid { grid-template-columns: minmax(0, 1fr); }\r\n  html:root:root .planning-aside { display: grid; grid-template-columns: 1fr 1fr; }\r\n  html:root:root .planning-aside .map-panel { grid-row: span 2; }\r\n  html:root:root .topbar { flex-wrap: wrap; }\r\n  html:root:root .topbar-actions { flex: 1; }\r\n  html:root:root .journeys-grid { grid-template-columns: repeat(2,