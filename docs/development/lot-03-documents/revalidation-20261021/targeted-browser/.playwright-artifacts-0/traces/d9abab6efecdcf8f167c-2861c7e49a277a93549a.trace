rder: 0; margin: 0; padding: 0; display: grid; gap: 12px; }\r\n.planning-item-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }\r\n.planning-item-toolbar strong { margin-right: auto; font-size: 14px; }\r\n.planning-excluded { opacity: .7; }\r\n.planning-evidence { font-size: 12px; overflow-wrap: anywhere; }\r\n.planning-evidence dt { font-weight: 600; }\r\n.planning-evidence dd { margin: 4px 0 12px; white-space: pre-wrap; }\r\n.planning-source { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 13px; max-height: 360px; overflow-y: auto; }\r\n.planning-summary { border-top: 1px solid var(--line); padding-top: 16px; font-weight: 600; overflow-wrap: anywhere; }\r\n@media (max-width: 500px) { .planning-import .form-row { grid-template-columns: minmax(0, 1fr); } .planning-item { padding: 12px; } }\r\n\r\n.planning-passages { min-width: 0; overflow-wrap: anywhere; }\r\n.planning-passages details { border: 1px solid var(--line); border-radius: 8px; padding: 12px; margin: 8px 0; }\r\n.planning-passages summary { cursor: pointer; }\r\n.planning-import [id] { scroll-margin-block: 24px; }\r\n\r\n.planning-kit .planning-actions a { white-space: normal; overflow-wrap: anywhere; max-width: 100%; }\r\n.planning-kit { min-width: 0; overflow-wrap: anywhere; }\r\n"]],["BODY",{"style":"overflow: hidden;"},["DIV",{"id":"root"},["DIV",{"class":"journeys-shell"},[[4,1]],[[4,33]],[[1,3]],[[4,662]]]],[[5,59]],["DIV",{"class":"modal-backdrop","style":"--scrim-opacity: 0.9918630388212004;"},["DIV",{"class":"modal modal-wide","role":"dialog","aria-modal":"true","aria-labelledby":"modal-title","tabindex":"-1","style":"transform: translate3d(0px, 5.63078px, 0px); opacity: 0.84359; will-change: transform, opacity;"},["DIV",{"class":"sheet-grabber","aria-hidden":"true"}],["DIV",{"class":"modal-heading"},["H2",{"id":"modal-title"},"Créer depuis un planning"],["BUTTON",{"class":"icon-btn","aria-label":"Fermer"},["svg",{"xmlns":"h