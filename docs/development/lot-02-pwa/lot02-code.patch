diff --git a/scripts/generate-pwa-icons.mjs b/scripts/generate-pwa-icons.mjs
new file mode 100644
index 0000000..41c7c1a
--- /dev/null
+++ b/scripts/generate-pwa-icons.mjs
@@ -0,0 +1,27 @@
+import { readFile, mkdir, writeFile } from 'node:fs/promises';
+import { chromium } from '@playwright/test';
+import { chromiumTestOptions } from './browser-test-options.ts';
+
+// Rasterize the existing project identity; no service or additional dependency.
+const svg = await readFile('public/favicon.svg', 'utf8');
+const browser = await chromium.launch(chromiumTestOptions());
+try {
+  const page = await browser.newPage();
+  await mkdir('public/icons', { recursive: true });
+  for (const [name, size, maskable] of [['apple-touch-icon', 180, false], ['icon-192', 192, false], ['icon-512', 512, false], ['maskable-512', 512, true]]) {
+    const data = await page.evaluate(async ({ svg, size, maskable }) => {
+      const image = new Image();
+      image.src = 'data:image/svg+xml,' + encodeURIComponent(svg);
+      await image.decode();
+      const canvas = document.createElement('canvas'); canvas.width = canvas.height = size;
+      const ctx = canvas.getContext('2d');
+      ctx.fillStyle = '#0071e3'; ctx.fillRect(0, 0, size, size);
+      // All foreground pixels inside radius .4*size (maskable safe zone).
+      const scale = maskable ? .65 : 1;
+      const inset = (1 - scale) * size / 2;
+      ctx.drawImage(image, inset, inset, size * scale, size * scale);
+      return canvas.toDataURL('image/png').split(',')[1];
+    }, { svg, size, maskable });
+    await writeFile(`public/icons/${name}.png`, Buffer.from(data, 'base64'));
+  }
+} finally { await browser.close(); }
diff --git a/scripts/smoke-pwa-mobile.mjs b/scripts/smoke-pwa-mobile.mjs
