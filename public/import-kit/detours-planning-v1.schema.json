{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Détours structured planning v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "detours-planning"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 140,
      "minLength": 1,
      "pattern": "\\S"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3,
      "minLength": 1,
      "pattern": "\\S",
      "format": "currency"
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "minLength": 1,
      "pattern": "\\S",
      "format": "timezone"
    },
    "cities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/city"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000,
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "format",
    "version",
    "title",
    "currency",
    "timezone",
    "cities",
    "notes",
    "ambiguities",
    "unmapped"
  ],
  "additionalProperties": false,
  "$defs": {
    "city": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "name",
        "days"
      ],
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10,
          "minLength": 1,
          "pattern": "\\S",
          "format": "date"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "title",
        "date",
        "items"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "activity",
            "stay",
            "transfer",
            "suggestion",
            "alternative"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "visit",
            "food",
            "transport",
            "hotel",
            "walk",
            "shopping"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5,
          "minLength": 1,
          "pattern": "\\S",
          "format": "time"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "checkIn": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10,
          "minLength": 1,
          "pattern": "\\S",
          "format": "date"
        },
        "checkOut": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10,
          "minLength": 1,
          "pattern": "\\S",
          "format": "date"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "enum": [
            "train",
            "plane",
            "bus",
            "car",
            "other",
            null
          ]
        },
        "departure": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16,
          "minLength": 1,
          "pattern": "\\S",
          "format": "local-date-time"
        },
        "arrival": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16,
          "minLength": 1,
          "pattern": "\\S",
          "format": "local-date-time"
        },
        "reservation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "confirmed"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500,
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "status",
            "reference"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "title",
        "category",
        "description",
        "address",
        "time",
        "period",
        "checkIn",
        "checkOut",
        "from",
        "to",
        "mode",
        "departure",
        "arrival",
        "reservation"
      ],
      "additionalProperties": false
    }
  }
}
